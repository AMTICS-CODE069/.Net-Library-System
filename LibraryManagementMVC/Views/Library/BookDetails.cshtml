@model LibraryMember
@{
    ViewData["Title"] = "Book Details";
    var status = Model.GetDueStatus();
    var fine = Model.CalculateFine();
}

<h2>Book Issue Details</h2>

@* Conditional Bootstrap alerts based on due status *@
@if (status == "Returned")
{
    <div class="alert alert-success" role="alert">
         This book has been <strong>returned</strong> by @Model.MemberName.
    </div>
}
else if (status == "Due Soon")
{
    <div class="alert alert-warning" role="alert">
        This book is <strong>due soon</strong> (due on @Model.GetDueDate().ToString("dd-MMM-yyyy")). Please remind the student.
    </div>
}
else if (status == "Overdue")
{
    <div class="alert alert-danger" role="alert">
         This book is <strong>overdue</strong>! It was due on @Model.GetDueDate().ToString("dd-MMM-yyyy").
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        ℹ️ This book is currently <strong>issued</strong> and not yet due.
    </div>
}

@if (fine > 0)
{
    <div class="alert alert-danger">
        💰 Outstanding fine: <strong>₹@fine.ToString("0.00")</strong> (₹10 per overdue day)
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-dark text-white">Member Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Member Name</dt>
                    <dd class="col-sm-8">@Model.MemberName</dd>

                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@Model.Department</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-dark text-white">Book Information</div>
            <div class="card-body">
                @if (Model.IssuedBook != null)
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Title</dt>
                        <dd class="col-sm-8">@Model.IssuedBook.Title</dd>

                        <dt class="col-sm-4">Author</dt>
                        <dd class="col-sm-8">@Model.IssuedBook.Author</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.IssuedBook.Category</dd>
                    </dl>
                }
                else
                {
                    <p class="text-muted mb-0">Book details unavailable.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header bg-dark text-white">Issue / Return Information</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Issue Date</dt>
            <dd class="col-sm-3">@Model.IssueDate.ToString("dd-MMM-yyyy")</dd>

            <dt class="col-sm-3">Due Date</dt>
            <dd class="col-sm-3">@Model.GetDueDate().ToString("dd-MMM-yyyy")</dd>

            <dt class="col-sm-3">Return Date</dt>
            <dd class="col-sm-3">@(Model.ReturnDate.HasValue ? Model.ReturnDate.Value.ToString("dd-MMM-yyyy") : "Not Returned")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-3">@status</dd>
        </dl>
    </div>
</div>

<a class="btn btn-outline-secondary" asp-controller="Library" asp-action="Index">&larr; Back to Issued Books</a>
