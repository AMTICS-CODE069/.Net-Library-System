@{
    ViewData["Title"] = "About";
}

<h2>About the UTU Library</h2>

<div class="card">
    <div class="card-body">
        <p>
            Welcome to the <strong>UTU Library</strong> — a resource centre dedicated to supporting
            the academic and research needs of our students and faculty. Our collection spans computer
            science, engineering, mathematics, and general reference material.
        </p>
        <ul>
            <li><strong>Working Hours:</strong> Monday – Saturday, 9:00 AM – 6:00 PM</li>
            <li><strong>Loan Period:</strong> 14 days per book</li>
            <li><strong>Late Fine:</strong> 10Rs per day for overdue books</li>
            <li><strong>Contact:</strong> library@utu.edu</li>
        </ul>
        <p>
            This <em>Book Issue System</em> was built using ASP.NET Core MVC by Hasan.
        </p>
    </div>
</div>

<a class="btn btn-primary mt-3" asp-controller="Library" asp-action="Index">&larr; Back to Issued Books</a>
